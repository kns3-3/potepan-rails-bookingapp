<div class="container">
  <h2>予約済み施設一覧</h2>

  <table>
    <thead>
      <tr>
        <th>施設名</th>
        <th>チェックイン</th>
        <th>チェックアウト</th>
        <th>予約日</th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |res| %>
        <tr>
          <td><%= link_to res.room.name, room_path(res.room) %></td>
          <td><%= res.start_date %></td>
          <td><%= res.end_date %></td>
          <td><%= res.created_at.strftime('%Y/%m/%d') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
