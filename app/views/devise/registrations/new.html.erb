<div class="new-wrapper">

  <div class="form-box">

    <h2 class="new-title">新規登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      
      <div class="field">
        <%= f.label :name, "ユーザー名", class: "form-label" %>
        <span class="require">*</span>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "form-input", placeholder: "ユーザー名を入力" %>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <span class="require">*</span>
        <%= f.email_field :email, autocomplete: "email", class: "form-input", placeholder: "メールアドレスを入力" %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <span class="require">*</span>
        <% if @minimum_password_length %>
          <em class="password-hint">(<%= @minimum_password_length %>文字以上を入力してください)</em>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input", placeholder: "パスワードを入力" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード(確認用)", class: "form-label" %>
        <span class="require">*</span>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input", placeholder: "確認用パスワードを入力" %>
      </div>

      <div class="actions">
        <%= f.submit "新しいアカウントを作成", class: "new-submit-btn" %>
      </div>
    <% end %>

    <div class="login-link">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
