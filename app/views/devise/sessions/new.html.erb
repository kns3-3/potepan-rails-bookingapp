<div class="new-wrapper">

  <div class="form-box">

    <h2 class="new-title">ログイン</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="field">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "form-input", placeholder: "メールアドレスを入力" %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input", placeholder: "パスワードを入力" %>
      </div>

      
      <% if devise_mapping.rememberable? %>
        <div class="field">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "ログイン状態を保持する" %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "ログイン", class: "new-submit-btn" %>
      </div>
    <% end %>

    <div class="login-link">
      <%= link_to "新しいアカウントを作成", new_registration_path(resource_name) %>
    </div>

    <div class="forgot-link">
      <%= link_to "※パスワードを忘れた方はこちら", new_password_path(resource_name) %>
    </div>
  </div>
</div>
