<div class="top-wrapper">
    <h1>JourneyInnで、心が動く旅へ。</h1>

    <%= form_with url: search_rooms_path, local: true, method: :get do |f| %>
      <div class="search-field">
        <%= f.select :area, [["東京", "東京"], ["大阪", "大阪"], ["京都", "京都"], ["札幌", "札幌"]], include_blank: "エリアを選択" %>
        <%= f.submit "検索", class: "search-submit-btn" %>
      </div>
    <% end %>
</div>
