<div class="show-container">
  <div class="show-if">
    <div class="account-header">
      <h2 class="account-title">施設詳細</h2>
      <%= link_to "✎編集", edit_room_path(@room), class: "edit-link" %>
    </div>

    <div class="profile-content">
      <div class="pic-field">
        <span class="account-label">施設画像</span>
        <div class="account-input">
          <% if @room.image.attached? %>
            <%= image_tag @room.image, class: "user-icon-large", style: "border-radius: 10px; width: 200px; height: auto;" %>
          <% else %>
            <%= image_tag "room.png", class: "user-icon-large", style: "border-radius: 10px; width: 200px; height: auto;" %>
          <% end %>
        </div>
      </div>

      <div class="name-field">
        <span class="account-label">施設名</span>
        <span class="account-input"><%= @room.name %></span>
      </div>

      <div class="intro-field">
        <span class="account-label">施設詳細</span>
        <span class="account-input"><%= @room.description %></span>
      </div>

      <div class="mail-field">
        <span class="account-label">宿泊料金</span>
        <span class="account-input">¥<%= @room.price.to_fs(:delimited) %> / 日</span>
      </div>

      <div class="pass-field">
        <span class="account-label">住所</span>
        <span class="account-input"><%= @room.address %></span>
      </div>
    </div>

    <div class="totop-link">
      <%= link_to "一覧へ戻る", rooms_path %>
    </div>
  </div>
</div>