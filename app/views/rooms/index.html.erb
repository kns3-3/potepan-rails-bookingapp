<div class="room-index-container">
  <h2 class ="index-title">登録済み施設一覧</h2>

  <table class="room-table">
    <thead>
      <tr>
      <th class="th-image">画像</th>
        <th class="th-name">施設名</th>
        <th class="th-intro">紹介文</th>
        <th class="th-price">料金</th>
        <th class="th-date">作成日</th>
        <th class="th-action"></th>
      </tr>
    </thead>

    <tbody>
      <% @rooms.each do |room| %>
        <tr>
          <td>
            <% if room.image.attached? %>
              <%= image_tag room.image, class: "table-img" %>
            <% else %>
              <%= image_tag "room.png", class: "table-img" %>
            <% end %>
          </td>

          <td>
            <%= link_to room.name, room_path(room), class: "room-link" %>
          </td>

          <td class="td-intro">
            <%= room.description %>
          </td>

          <td class="td-price">
            ¥<%= room.price&.to_fs(:delimited) %>〜
          </td>

          <td class="td-date">
            <%= room.created_at.to_fs(:datetime_jp) %>
          </td>

          <td class="td-action">
            <div class="room-menu-container">
                <span class="menu-dots" onclick="toggleMenu(this)">⋮</span>
                <div class="room-dropdown">
                    <%= link_to "編集", edit_room_path(room), class: "dropdown-item" %>
                    <%= link_to "削除", room_path(room), 
                                data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, 
                                class: "dropdown-item delete-text" %>
                </div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
