<div class="search-container">

  <div class="search-header">
    <div class="search-form-inline">
      <%= form_with url: search_rooms_path, method: :get, local: true do |f| %>
        <div class="form-group">
          <%# エリア用入力フォーム params[:area]と書くことで、検索後も入力した文字が消えずに残る %>
          <%= f.text_field :area, value: params[:area], placeholder: "エリア名を入力" %>
        </div>

        <div class="form-group">
          <%# キーワード用入力フォーム ここもparams[:keyword]で入力した文字を保持する %>
          <%= f.text_field :keyword, value: params[:keyword], placeholder: "キーワード名を入力" %>
        </div>

        <%= f.submit "検索", class: "search-btn" %>
      <% end %>
    </div>
  </div>

  <div class="room-count"><%= @count %>件が見つかりました</div>

  <div class="room-list">
    <% @rooms.each do |room| %>
      <div class="room-card">
        <div class="room-image">
          <% if room.image.attached? %>
            <%= image_tag room.image, class: "table-img" %>
          <% else %>
            <%= image_tag "room.png", class: "table-img" %>
          <% end %>
        </div>
        <div class="room-info">
          <h3><%= link_to room.name, room_path(room) %></h3>
          <p class="room-address"><%= room.address %></p>
          <p class="room-description"><%= room.description %></p>
          <p class="room-price">¥<%= room.price.to_fs(:delimited) %> ～</p>
          
          <div class="link-box">
            <%= link_to "詳細はこちら", room_path(room), class: "detail-btn" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
