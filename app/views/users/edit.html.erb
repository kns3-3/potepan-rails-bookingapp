<div class="new-wrapper">
  <div class="form-box">
    <% if params[:type] == "account" %>
      <h2 class="new-title">アカウント編集</h2>
      <%= form_with model: @user, local: true do |f| %>
        <%= hidden_field_tag :update_type, "account" %> <%# どっちの更新か判別用 %>
        
        <div class="field">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, class: "form-input" %>
        </div>
        <div class="field">
          <%= f.label :password, "新しいパスワード", class: "form-label" %>
          <%= f.password_field :password, class: "form-input" %>
        </div>
        <div class="field">
          <%= f.label :password_confirmation, "パスワード再入力", class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-input" %>
        </div>
        <%= f.submit "アカウントを更新", class: "new-submit-btn" %>
        <%= link_to "キャンセル", user_path(@user, type: "account"), class: "cancel-btn" %>
      <% end %>

    <% else %> <%# プロフィール編集 %>
      <h2 class="new-title">プロフィール編集</h2>
      <%= form_with model: @user, local: true do |f| %>
        <%= hidden_field_tag :update_type, "profile" %>

        <div class="field">
          <%= f.label :name, "名前", class: "form-label" %>
          <%= f.text_field :name, class: "form-input" %>
        </div>
        <div class="field">
          <%= f.label :introduction, "自己紹介", class: "form-label" %>
          <%= f.text_area :introduction, class: "form-input", style: "height: 100px;" %>
        </div>
        <%= f.submit "プロフィールを更新", class: "new-submit-btn" %>
        <%= link_to "キャンセル", user_path(@user, type: "profile"), class: "cancel-btn" %>
      <% end %>
    <% end %>
  </div>
</div>
