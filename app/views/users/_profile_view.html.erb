<div class="account-header">
  <h2 class="account-title">プロフィール</h2>
  <%= link_to "✎編集", edit_user_path(@user, type: "profile"), class: "edit-link" %>
</div>

<div class="profile-content">
  <div class="pic-field">
    <span class="account-label">アイコン画像</span>
    <div class="account-input">
      <% if @user.image.attached? %>
        <%# 登録した画像がある場合 %>
        <%= image_tag @user.image, class: "user-icon-large" %>
      <% else %>
        <%# 画像がない場合は、デフォルト画像を表示 %>
        <%= image_tag "icon.png", class: "user-icon-large" %>
      <% end %>
   </div>
  </div>

  <div class="name-field">
      <span class="account-label">名前</span>
      <span class="account-input"><%= @user.name.presence || "未設定" %></span>
  </div>

  <div class="intro-field">
    <span class="account-label">自己紹介</span>
    <span class="account-input"><%= @user.introduction.presence || "未設定" %></span>
  </div>
