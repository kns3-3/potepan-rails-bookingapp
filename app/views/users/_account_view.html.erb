<div class="account-header">
  <h2 class="account-title">アカウント</h2>
  <%= link_to "✎編集", edit_user_path(@user, type: "account"), class: "edit-link" %>
</div>

<div class="account-info">
  <div class="mail-field">
    <span class="account-label">メールアドレス</span>
    <span class="account-input"><%= @user.email %></span>
  </div>

  <div class="pass-field">
    <span class="account-label">パスワード</span>
    <span class="account-input">**********</span>
  </div>
</div>
